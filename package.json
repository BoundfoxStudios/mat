{
  "name": "mat",
  "version": "1.1.0",
  "description": "Preview a Markdown file in your browser, the way GitHub renders it",
  "keywords": [
    "markdown",
    "preview",
    "github-flavored-markdown",
    "cli",
    "renderer",
    "mermaid",
    "katex",
    "syntax-highlighting",
    "bun"
  ],
  "license": "MIT",
  "author": "Manuel Rauber",
  "homepage": "https://github.com/BoundfoxStudios/mat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoundfoxStudios/mat.git"
  },
  "bugs": {
    "url": "https://github.com/BoundfoxStudios/mat/issues"
  },
  "type": "module",
  "private": true,
  "bin": {
    "mat": "./dist/mat"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build:assets": "bun run scripts/embed.ts && bun run scripts/embed-grammars.ts",
    "build": "bun run build:assets && bun run scripts/build.ts",
    "dev": "bun run build:assets && bun run src/cli.ts",
    "test": "bun test --timeout 60000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "notices": "bunx license-checker-rseidelsohn@5.0.1 --markdown --excludePrivatePackages --excludePackagesStartingWith \"@biomejs;@types/;@typescript/;typescript;playwright;bun-types;undici-types;fsevents\" --customPath scripts/third-party-notices-format.json --out THIRD-PARTY-NOTICES.md",
    "ci": "biome ci ."
  },
  "dependencies": {
    "@wooorm/starry-night": "3.10.0",
    "cmd-ts": "0.15.0",
    "consola": "3.4.2",
    "github-slugger": "2.0.0",
    "hast-util-to-html": "9.0.5",
    "katex": "0.16.46",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-github-blockquote-alert": "2.1.0",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "github-markdown-css": "5.9.0",
    "hast-util-from-html": "2.0.3",
    "mermaid": "11.16.1",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "katex": "0.16.46"
  },
  "patchedDependencies": {
    "@wooorm/starry-night@3.10.0": "patches/@wooorm%2Fstarry-night@3.10.0.patch"
  }
}
